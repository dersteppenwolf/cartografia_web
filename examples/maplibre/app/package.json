{
  "name": "maplibre-course-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:cog": "python prepare_cog_protocol.py",
    "dev": "npm run prepare:cog && vite --host 0.0.0.0",
    "build": "npm run prepare:cog && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "npm run prepare:cog && playwright test --config playwright.config.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@geomatico/maplibre-cog-protocol": "^0.9.1",
    "maplibre-gl": "^6.1.0",
    "pmtiles": "^4.4.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
